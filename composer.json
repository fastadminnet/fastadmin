{
    "name": "fastadminnet/fastadmin",
    "description": "FastAdmin on ThinkPHP 8",
    "type": "project",
    "keywords": [
        "fastadmin",
        "thinkphp"
    ],
    "homepage": "https://www.fastadmin.net/",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Karson",
            "email": "karson@fastadmin.net"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.9",
        "nelexa/zip": "^4.0",
        "overtrue/pinyin": "^6.0",
        "phpoffice/phpspreadsheet": "^5.10",
        "ramsey/uuid": "^4.9",
        "topthink/framework": "^8.1",
        "topthink/think-captcha": "^3.0",
        "topthink/think-helper": "^3.1",
        "topthink/think-multi-app": "^1.1",
        "topthink/think-queue": "^3.0",
        "topthink/think-template": "^3.0",
        "topthink/think-view": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app",
            "fast\\": "extend/fast",
            "fastaddons\\": "extend/fastaddons/src/",
            "addons\\": "addons/"
        },
        "classmap": [
            "extend/fast/Form.php"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
